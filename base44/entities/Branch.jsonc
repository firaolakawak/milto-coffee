{
  "name": "Branch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Branch name"
    },
    "name_am": {
      "type": "string",
      "description": "Branch name in Amharic"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "A short description of this branch (up to 1000 characters)",
      "maxLength": 1000
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "opening_hours": {
      "type": "string",
      "description": "e.g. 6:00 AM - 10:00 PM"
    },
    "image_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "estimated_wait_minutes": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}