{
  "name": "CoffeeOrigin",
  "type": "object",
  "properties": {
    "region": {
      "type": "string"
    },
    "region_am": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "A brief overview of this coffee origin (up to 1000 characters)",
      "maxLength": 1000
    },
    "story": {
      "type": "string"
    },
    "story_am": {
      "type": "string"
    },
    "flavor_profile": {
      "type": "string"
    },
    "altitude": {
      "type": "string"
    },
    "processing_method": {
      "type": "string"
    },
    "farmer_info": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "region"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}