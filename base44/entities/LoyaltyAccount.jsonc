{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "total_points_earned": {
      "type": "number",
      "default": 0
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by": {
      "type": "string"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": []
}