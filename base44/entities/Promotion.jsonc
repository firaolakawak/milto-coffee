{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "title_am": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_am": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number"
    },
    "min_order": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "image_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "code",
    "discount_type",
    "discount_value"
  ]
}