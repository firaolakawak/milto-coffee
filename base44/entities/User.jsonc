{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string",
      "description": "User's mobile phone number"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "am"
      ],
      "default": "en"
    },
    "favorite_coffee": {
      "type": "string"
    },
    "saved_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "birthday_day": {
      "type": "number",
      "description": "Day of birth (1\u201331)"
    },
    "birthday_month": {
      "type": "number",
      "description": "Month of birth (1\u201312)"
    }
  },
  "required": [
    "phone"
  ]
}